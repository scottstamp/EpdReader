menuconfig DISPLAY_GDEY037T03
	bool "Good Display GDEY037T03 (UC8253) e-Paper display driver"
	default y
	depends on DT_HAS_GOODDISPLAY_GDEY037T03_ENABLED
	select DISPLAY_HAS_PIXEL_FORMAT_MONO10
	help
	  Enable driver for Good Display GDEY037T03 3.7" e-Paper display (UC8253 controller).

if DISPLAY_GDEY037T03

config GDEY037T03_DEFAULT_REFRESH_PROFILE
	int "Default partial refresh profile (0=Normal, 1=Fast, 2=Turbo, 3=Custom)"
	default 0
	range 0 3
	help
	  Default refresh profile for the GDEY037T03 display.
	  0 = Normal (pulse interval 2, 3 pulses)
	  1 = Fast (pulse interval 2, 2 pulses)
	  2 = Turbo (pulse interval 1, 1 pulse)
	  3 = Custom (user defined pulse interval, pulse count and frame rate)
	  Fewer/shorter pulses give shorter refreshes but erase old text less
	  completely. All but Custom run at the controller's default frame rate.

config GDEY037T03_CUSTOM_PULSE_INTERVAL
	int "Custom pulse timing interval (frames/cycles)"
	default 2
	range 1 15
	help
	  Pulse timing duration (T1..T4) when Custom profile is active.

config GDEY037T03_KEEP_POWERED
	bool "Keep the panel powered between partial refreshes (experimental)"
	help
	  Skip the power-off and soft reset after each refresh and keep the
	  partial waveform loaded, powering off after a short idle period.
	  Faster page turns, but caused page images to pile up (old pixels
	  not erased) on GDEY037T03 hardware, so it is off by default.

config GDEY037T03_CUSTOM_PULSE_COUNT
	int "Custom pulse repetition count"
	default 3
	range 1 5
	help
	  Number of pulse drive repetitions (Repeat count / RP).

config GDEY037T03_CUSTOM_FRAME_RATE
	int "Custom frame rate in Hz (0 = controller default)"
	default 0
	range 0 200
	help
	  Frame rate written to the UC8253 PLL register (0x30) before each
	  partial refresh when the Custom profile is active. The datasheet
	  lists 5-120 Hz in 5 Hz steps and 130-200 Hz in 10 Hz steps; other
	  values are rounded to the nearest. The waveform's frame part of
	  the refresh time scales with 1/frame rate. 0 leaves the register
	  at its reset default.

endif
